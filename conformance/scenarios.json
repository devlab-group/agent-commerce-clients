{
  "version": 1,
  "testSignerPrivateKey": "0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6",
  "testSignerAddress": "0xa0Ee7A142d267C1f36714E4a8F75612F20a79720",
  "defaults": {
    "gatewayUrl": "https://merchant.example.com",
    "networks": [
      "eip155:84532"
    ],
    "maxPerCall": "0.05",
    "maxPerDay": "1.00"
  },
  "config": [
    {
      "name": "defaults are valid",
      "config": {},
      "expect": "ok"
    },
    {
      "name": "local Anvil chain counts as a testnet",
      "config": {
        "networks": [
          "eip155:31337"
        ]
      },
      "expect": "ok"
    },
    {
      "name": "mainnet without allowMainnet is refused",
      "config": {
        "networks": [
          "eip155:8453"
        ]
      },
      "expect": "error"
    },
    {
      "name": "mainnet with allowMainnet is accepted",
      "config": {
        "networks": [
          "eip155:8453"
        ],
        "allowMainnet": true
      },
      "expect": "ok"
    },
    {
      "name": "unknown chain is refused",
      "config": {
        "networks": [
          "eip155:999999"
        ]
      },
      "expect": "error"
    },
    {
      "name": "unknown chain is refused even with allowMainnet",
      "config": {
        "networks": [
          "eip155:999999"
        ],
        "allowMainnet": true
      },
      "expect": "error"
    },
    {
      "name": "non-EVM network is refused",
      "config": {
        "networks": [
          "solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1"
        ]
      },
      "expect": "error"
    },
    {
      "name": "empty networks is refused",
      "config": {
        "networks": []
      },
      "expect": "error"
    },
    {
      "name": "missing gatewayUrl is refused",
      "config": {
        "gatewayUrl": null
      },
      "expect": "error"
    },
    {
      "name": "non-numeric limit is refused",
      "config": {
        "maxPerCall": "abc"
      },
      "expect": "error"
    },
    {
      "name": "negative limit is refused",
      "config": {
        "maxPerDay": "-1"
      },
      "expect": "error"
    },
    {
      "name": "more than 6 decimals is refused",
      "config": {
        "maxPerCall": "0.0000001"
      },
      "expect": "error"
    },
    {
      "name": "unknown approval mode is refused",
      "config": {
        "approval": "sometimes"
      },
      "expect": "error"
    }
  ],
  "discovery": [
    {
      "name": "keeps http resources that are free or paid through x402",
      "config": {},
      "resources": "resources.json",
      "expect": {
        "tools": [
          {
            "name": "report",
            "description": "Returns a small demo report. Costs 0.01 USDC per call.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "topic": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "paid": true,
            "needsApproval": true
          },
          {
            "name": "weather_basic",
            "description": "Current basic weather for a city. Free.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ],
              "additionalProperties": false
            },
            "paid": false,
            "needsApproval": false
          },
          {
            "name": "no_description",
            "description": "Undescribed Paid Tool. Costs 0.02 USDC per call.",
            "inputSchema": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            },
            "paid": true,
            "needsApproval": true
          },
          {
            "name": "no_schema",
            "description": "Free tool without a schema! Free.",
            "inputSchema": {
              "type": "object",
              "properties": {}
            },
            "paid": false,
            "needsApproval": false
          }
        ],
        "skipped": [
          "mcp_only",
          "mpp_only"
        ]
      }
    },
    {
      "name": "resources allowlist keeps only listed eligible ids",
      "config": {
        "resources": [
          "report",
          "mcp_only",
          "missing_id"
        ]
      },
      "resources": "resources.json",
      "expect": {
        "toolNames": [
          "report"
        ],
        "skipped": [
          "weather_basic",
          "mcp_only",
          "no_description",
          "mpp_only",
          "no_schema"
        ]
      }
    },
    {
      "name": "approval always marks every tool",
      "config": {
        "approval": "always"
      },
      "resources": "resources.json",
      "expect": {
        "needsApproval": {
          "report": true,
          "weather_basic": true,
          "no_description": true,
          "no_schema": true
        }
      }
    },
    {
      "name": "approval never marks no tool",
      "config": {
        "approval": "never"
      },
      "resources": "resources.json",
      "expect": {
        "needsApproval": {
          "report": false,
          "weather_basic": false,
          "no_description": false,
          "no_schema": false
        }
      }
    },
    {
      "name": "unreachable gateway during discovery",
      "config": {},
      "response": {
        "networkError": true
      },
      "expect": {
        "error": {
          "code": "GATEWAY_UNREACHABLE"
        }
      }
    },
    {
      "name": "discovery 5xx",
      "config": {},
      "response": {
        "status": 500,
        "body": {
          "status": "error",
          "code": "INTERNAL_ERROR",
          "message": "Internal error"
        }
      },
      "expect": {
        "error": {
          "code": "BACKEND_ERROR",
          "status": 500
        }
      }
    }
  ],
